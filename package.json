{
  "name": "soundmate",
  "version": "1.0.0",
  "description": "Find your spotify soundmate",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^24.8"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @soundmate/app --filter @soundmate/client dev",
    "build:app": "sh scripts/build-app.sh",
    "build:client": "pnpm --filter @soundmate/client exec vite build",
    "heroku-postbuild": "pnpm build:app",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
