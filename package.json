{
  "name": "soundmate",
  "version": "1.0.0",
  "description": "Find your spotify soundmate",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "client:dev": "vite",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit && pnpm client:typecheck",
    "client:typecheck": "tsc -p src/client/tsconfig.json --noEmit",
    "build": "pnpm clean && tsc && vite build",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.1",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lit": "^3.3.3",
    "redis": "^6.0.0",
    "zod": "^4.4.3"
  }
}
