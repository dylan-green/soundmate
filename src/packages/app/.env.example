# @soundmate/app — backend env. Copy to `.env` and fill in.
# Loaded by `pnpm dev` / `pnpm start:local` via --env-file=.env (cwd = this package).
# In production these come from the host's environment, not this file.
#
# DEV GOTCHA: open the client at http://127.0.0.1:5173 — NOT http://localhost:5173.
# The browser treats 127.0.0.1 and localhost as different origins, so the session
# cookie set by the login callback (scoped to 127.0.0.1, matching CLIENT_BASE_URL)
# is invisible to a localhost tab, and login silently fails. Also register
# SPOTIFY_REDIRECT_URI exactly in the Spotify dashboard or /authorize 400s with
# "redirect_uri: Not matching configuration".

# Optional — defaults to 8080.
PORT=XXXX

# Spotify app credentials (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must EXACTLY match a Redirect URI registered in the Spotify dashboard.
# Local dev uses the loopback IP (never http://localhost). Prod must be HTTPS.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/login/callback

# The client's origin: BOTH the post-login redirect target AND the allowed CORS
# origin (must match the deployed @soundmate/client URL). In dev this is Vite's origin.
CLIENT_BASE_URL=http://127.0.0.1:5173

# Session + library store. Full URL with scheme; rediss:// for TLS.
REDIS_URL=redis://127.0.0.1:6379

# Signs the session cookie. Keep private; rotating it invalidates all sessions.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
