{
  "name": "@soundmate/app",
  "version": "1.0.0",
  "description": "soundmate backend — Express + Spotify Web API",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tsx watch --env-file=.env index.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node ../../../dist/app/index.js",
    "start:local": "node --env-file=.env ../../../dist/app/index.js",
    "test": "tsx --test \"**/*.test.ts\"",
    "clean": "rm -rf ../../../dist/app"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "@soundmate/common": "workspace:*",
    "connect-redis": "9",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "redis": "^6.0.0",
    "zod": "^4.4.3"
  }
}
