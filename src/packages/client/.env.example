# @soundmate/client — frontend build env. Copy to `.env` and fill in.
# Vite auto-loads .env from this package. Only VITE_-prefixed vars are exposed to
# the browser bundle (see functions/api.ts).

# Absolute origin of the @soundmate/app API, baked into the bundle at build time.
# Leave EMPTY in dev: requests stay relative ("/me/...") and Vite proxies them to
# the API (same-origin, so the session cookie works without cross-site config).
# In production set this to the deployed API origin (CORS + SameSite=None handle
# the cross-site cookie). A change requires a rebuild/redeploy.
VITE_API_BASE_URL=
