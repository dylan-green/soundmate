{
  "name": "@soundmate/common",
  "version": "1.0.0",
  "description": "Shared types for the soundmate app + client",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "license": "ISC"
}
