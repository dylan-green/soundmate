{
  "name": "@soundmate/common",
  "version": "1.0.0",
  "description": "Shared types for the soundmate app + client",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "license": "ISC"
}
